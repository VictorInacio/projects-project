{:paths ["src" "resources"]
 :deps  {org.clojure/clojure               {:mvn/version "1.12.4"}
         org.clojure/clojurescript         {:mvn/version "1.11.132"}
         org.clojure/tools.namespace       {:mvn/version "1.4.4"}
         ;; Frontend state + rendering for CLJS live-eval demos
         reagent/reagent                   {:mvn/version "1.2.0"}
         re-frame/re-frame                 {:mvn/version "1.4.3"}
         ;; HTTP server & routing
         ring/ring-core                    {:mvn/version "1.12.1"}
         ring/ring-jetty-adapter           {:mvn/version "1.12.1"}
         metosin/reitit                    {:mvn/version "0.7.2"}
         metosin/reitit-malli              {:mvn/version "0.7.2"}
         metosin/reitit-swagger-ui         {:mvn/version "0.7.2"}
         metosin/muuntaja                  {:mvn/version "0.6.10"}
         ;; Validation
         metosin/malli                     {:mvn/version "0.16.4"}
         ;; Database
         com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
         org.xerial/sqlite-jdbc            {:mvn/version "3.45.3.0"}
         com.zaxxer/HikariCP               {:mvn/version "5.1.0"}
         ;; Component lifecycle
         integrant/integrant               {:mvn/version "0.10.0"}
         ;; Logging
         org.clojure/tools.logging         {:mvn/version "1.3.0"}
         ch.qos.logback/logback-classic    {:mvn/version "1.5.6"}}
 :aliases
 {:dev         {:extra-paths ["dev" "test"]
                :extra-deps  {nrepl/nrepl           {:mvn/version "1.3.1"}
                              integrant/repl        {:mvn/version "0.4.0"}
                              ring/ring-mock        {:mvn/version "0.4.0"}
                              org.clojure/data.json {:mvn/version "2.5.0"}}
                :main-opts   ["-m" "nrepl.cmdline" "--port" "7888"]}
  :test        {:extra-paths ["test"]
                :extra-deps  {lambdaisland/kaocha   {:mvn/version "1.91.1392"}
                              ring/ring-mock        {:mvn/version "0.4.0"}
                              org.clojure/data.json {:mvn/version "2.5.0"}}
                :main-opts   ["-m" "kaocha.runner"]}
  :run         {:main-opts ["-m" "projects.core"]}
  :shadow-cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.21"}}
                :main-opts  ["-m" "shadow.cljs.devtools.cli"]}}}
